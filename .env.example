# Supabase — preencha com os valores do SEU projeto (painel > Settings > API)
# Nota: este frontend lê as chaves de js/supabase.js; este arquivo serve apenas
# como referência para novos ambientes/contribuidores.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=sua-anon-key-aqui

# NOTA DE SEGURANÇA: a anon key do Supabase é pública por design (vai no navegador).
# A proteção real dos dados vem das policies RLS — ver supabase/migrations/0001_init.sql.
# NUNCA coloque a service_role key no frontend.
