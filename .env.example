# ============================================================
# Biofirme - exemplo de variaveis de ambiente
# Nunca coloque valores reais aqui. Configure na Vercel:
# Project Settings > Environment Variables
# ============================================================

# Neon Postgres (use a connection string "pooled")
DATABASE_URL=postgresql://USER:PASSWORD@HOST-POOLER.REGION.aws.neon.tech/biofirme?sslmode=require

# Segredo do JWT (minimo 32 bytes)
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=troque-por-um-segredo-forte

# Neon Object Storage (S3 compativel)
AWS_ENDPOINT_URL_S3=https://SEU-BRANCH.storage.REGION.aws.neon.tech
AWS_ACCESS_KEY_ID=nak_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=nsk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1
STORAGE_BUCKET=biofirme

# Origens liberadas no CORS do bucket (separadas por virgula)
ALLOWED_ORIGINS=http://localhost:3000,https://seu-projeto.vercel.app

# Usadas apenas por scripts/seed.js
SEED_PASSWORD_MARCUS=
SEED_PASSWORD_GESTOR=
